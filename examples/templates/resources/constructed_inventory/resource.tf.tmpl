resource "{{.Prefix}}_organization" "example" {
  name        = "Example Organization"
  description = "An example organization"
}

resource "{{.Prefix}}_inventory" "example" {
  name         = "Example Inventory"
  description  = "An example inventory"
  organization = {{.Prefix}}_organization.example.id
}

resource "{{.Prefix}}_constructed_inventory" "example" {
  name         = "Example Constructed Inventory"
  description  = "An example constructed inventory"
  organization = {{.Prefix}}_organization.example.id
  limit        = "dev,&no_mgmt"
  source_vars  = <<-EOT
---
plugin: ansible.builtin.constructed
strict: true
groups:
  dev: az_env_tag == "Development"
  no_mgmt: not ("mgmt" in inventory_hostname)
EOT
}

resource "{{.Prefix}}_inventory_input" "example" {
  constructed_inventory_id = {{.Prefix}}_constructed_inventory.example.id
  input_inventory_id       = {{.Prefix}}_inventory.example.id
}  